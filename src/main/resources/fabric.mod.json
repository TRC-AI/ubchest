		"trc_addon": [
			"trc.ubchest.TRCAddon"
		]
	},
	"mixins": [
		"ubchest.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": ["26.3"],
		"java": ">=25",
		"fabric-api": ">=0.160.5",
		"trc-core": ">=1.2"
	}
}